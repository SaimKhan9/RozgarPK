# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Aiven Quick Connect URI, with sslmode=require. Keep the real URI out of Git.
DATABASE_URL=postgres://avnadmin:yourpassword@your-aiven-host:15234/defaultdb?sslmode=require
DATABASE_CA_CERT_PATH=./aiven-ca.pem
# Local alternative when DATABASE_URL is not set:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rozgarpk
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT Secret
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES=15m

# Cloudinary (for photo uploads - optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
